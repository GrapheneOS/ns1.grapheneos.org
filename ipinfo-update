#!/bin/bash

set -o errexit -o nounset -o pipefail

curl -sSL --fail-with-body \
  --variable token@/etc/ipinfo-token.txt \
  --expand-url-query 'token={{token:trim}}' \
  -o ipinfo_location.mmdb.new https://ipinfo.io/data/ipinfo_location.mmdb

mmdblookup --file ipinfo_location.mmdb.new --ip 23.149.124.1 >/dev/null
sync ipinfo_location.mmdb.new
mv ipinfo_location.mmdb.new ipinfo_location.mmdb
sync .
